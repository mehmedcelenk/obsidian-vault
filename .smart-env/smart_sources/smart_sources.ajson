"smart_sources:Obsidian Community.md": {"class_name":"SmartSource","last_read":{"hash":"1had377","at":1791943254401},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":108,"read_hash":"1had377","at":1791943254659}}},"path":"Obsidian Community.md","last_import":{"mtime":1791943237039,"size":1500,"at":1791943254404,"hash":"1had377"},"outlinks":[{"title":"Plugins","target":"https://community.obsidian.md/search?type=plugin","line":5},{"title":"Popular","target":"https://community.obsidian.md/search?type=plugin","line":11},{"title":"\n\n### Notebook Navigator\n\nA better file browser and calendar inspired by Apple Notes, Bear, Evernote and Day One.\n\n\n\n","target":"https://community.obsidian.md/plugins/notebook-navigator","line":13},{"title":"\n\n### Excalidraw\n\nVisual PKM powerhouse. Create and edit Excalidraw drawings.\n\n\n\n","target":"https://community.obsidian.md/plugins/obsidian-excalidraw-plugin","line":21},{"title":"\n\n### Importer\n\nConvert your data to Markdown files you can use in Obsidian. Works with Apple Notes, OneNote, Evernote, Notion, Google Keep, and many other formats.\n\n\n\n","target":"https://community.obsidian.md/plugins/obsidian-importer","line":29},{"title":"\n\n### Advanced Canvas\n\nSupercharge your canvas experience. Create presentations, flowcharts and more.\n\n\n\n","target":"https://community.obsidian.md/plugins/advanced-canvas","line":37},{"title":"\n\n### Minimal Theme Settings\n\nControl the colors and fonts in Minimal Theme.\n\n\n\n","target":"https://community.obsidian.md/plugins/obsidian-minimal-settings","line":45},{"title":"\n\n### Admonition\n\nAdmonition block-styled content.\n\n\n\n","target":"https://community.obsidian.md/plugins/obsidian-admonition","line":53},{"title":"\n\n### Copilot\n\nRun AI agents such as Claude Code, Codex, and OpenCode inside your vault. Turn your second brain into a smart assistant that gets knowledge work done.\n\n\n\n","target":"https://community.obsidian.md/plugins/copilot","line":61},{"title":"Show more","target":"https://community.obsidian.md/search?type=plugin","line":71}],"blocks_data":{"##Make Obsidian yours.":{"text":null,"length":0,"last_read":{"hash":"1cizdqt","at":1791943254401},"key":"Obsidian Community.md##Make Obsidian yours.","lines":[1,4],"size":85,"should_embed":false},"##Make Obsidian yours.#{1}":{"text":null,"length":0,"last_read":{"hash":"1kcatlk","at":1791943254401},"key":"Obsidian Community.md##Make Obsidian yours.#{1}","lines":[3,4],"size":60,"should_embed":false},"##[Plugins](https://community.obsidian.md/search?type=plugin)":{"text":null,"length":0,"last_read":{"hash":"1hruqkd","at":1791943254401},"key":"Obsidian Community.md##[Plugins](https://community.obsidian.md/search?type=plugin)","lines":[5,71],"size":1414,"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":124,"read_hash":"1hruqkd","at":1791943254531}}}},"##[Plugins](https://community.obsidian.md/search?type=plugin)#{1}":{"text":null,"length":0,"last_read":{"hash":"9oj0p3","at":1791943254401},"key":"Obsidian Community.md##[Plugins](https://community.obsidian.md/search?type=plugin)#{1}","lines":[7,7],"size":9,"should_embed":false},"##[Plugins](https://community.obsidian.md/search?type=plugin)#{2}":{"text":null,"length":0,"last_read":{"hash":"1mij5y4","at":1791943254401},"key":"Obsidian Community.md##[Plugins](https://community.obsidian.md/search?type=plugin)#{2}","lines":[8,8],"size":5,"should_embed":false},"##[Plugins](https://community.obsidian.md/search?type=plugin)#{3}":{"text":null,"length":0,"last_read":{"hash":"119kgyo","at":1791943254401},"key":"Obsidian Community.md##[Plugins](https://community.obsidian.md/search?type=plugin)#{3}","lines":[9,10],"size":10,"should_embed":false},"##[Plugins](https://community.obsidian.md/search?type=plugin)#[Popular](https://community.obsidian.md/search?type=plugin)":{"text":null,"length":0,"last_read":{"hash":"1tzqred","at":1791943254401},"key":"Obsidian Communi